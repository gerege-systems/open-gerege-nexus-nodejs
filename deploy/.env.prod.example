# Production Environment Configuration for js.nexus.gerege.mn

# Docker Container Registry Images
IMAGE_BACKEND=ghcr.io/gerege-systems/open-gerege-nexus-nodejs-backend
IMAGE_FRONTEND=ghcr.io/gerege-systems/open-gerege-nexus-nodejs-frontend
IMAGE_TAG=latest

# Database configuration (isolated for js.nexus.gerege.mn)
POSTGRES_DB=js_platform_db
POSTGRES_USER=js_postgres
POSTGRES_PASSWORD=your_secure_random_postgres_password_here

# Domain / Origin Configuration
PUBLIC_ORIGIN=https://js.nexus.gerege.mn
SSO_DEFAULT_CLIENT_SECRET=your_secure_sso_client_secret_here
JWT_SECRET=your_secure_jwt_secret_key_2026

# Optional Services
GEMINI_API_KEY=
DEMO_MODE=false
EID_MOCK_MODE=false
